// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  role       String   // "ADMIN", "TEACHER"
  isApproved Boolean  @default(false)
  name       String?
  school       String?
  geminiApiKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  classes      Class[]
}

model Class {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentSessions StudentSession[]
}

model StudentSession {
  id            String   @id @default(uuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  studentNumber String
  name          String
  status        String   @default("STAGE_1") // "STAGE_1", "STAGE_2", "STAGE_3", "STAGE_4", "COMPLETED"
  quizScore     Int?
  quizAnswers   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages   Message[]
  evaluation Evaluation?
  survey     Survey?
  likes      FeedbackLike[]
  comments   FeedbackComment[]
}

model Message {
  id        String         @id @default(uuid())
  sessionId String
  session   StudentSession @relation(fields: [sessionId], references: [id])
  role      String         // "user", "model"
  content   String
  createdAt DateTime       @default(now())
}

model Evaluation {
  id           String         @id @default(uuid())
  sessionId    String         @unique
  session      StudentSession @relation(fields: [sessionId], references: [id])
  score        Int            // 1 to 5
  comment      String?
  satisfaction Int            // 1 to 5
  aiKeywords   String?        // CSV string of keywords
  aiSummary    String?        // One-line summary for student record
  grade        String?        // A, B, C, D
  gradeReason  String?
  createdAt    DateTime       @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Survey {
  id           String         @id @default(uuid())
  sessionId    String         @unique
  session      StudentSession @relation(fields: [sessionId], references: [id])
  q1           Int            // 1-5 scale
  q2           Int
  q3           Int
  q4           Int
  q5           String         // Text answer
  q6           String?        // Text answer (optional)
  createdAt    DateTime       @default(now())
}

model FeedbackLike {
  id        String         @id @default(uuid())
  sessionId String
  session   StudentSession @relation(fields: [sessionId], references: [id])
  likerName String         // name of student who liked
  createdAt DateTime       @default(now())

  @@unique([sessionId, likerName])
}

model FeedbackComment {
  id          String         @id @default(uuid())
  sessionId   String
  session     StudentSession @relation(fields: [sessionId], references: [id])
  authorName  String
  content     String
  createdAt   DateTime       @default(now())
}
